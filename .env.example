# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# DATABASE_URL  → Pooled connection (via PgBouncer) — used by app at runtime
#                 In Neon: copy the "Pooled connection" string from the dashboard
#                 Format: postgresql://USER:PASS@ep-xxx.pooler.neon.tech/dbname?sslmode=require
DATABASE_URL=

# DIRECT_URL    → Direct connection (non-pooled) — used ONLY by Prisma CLI
#                 In Neon: copy the "Direct connection" string from the dashboard
#                 Format: postgresql://USER:PASS@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=

# ─── AI / LLM ────────────────────────────────────────────────────────────────
# Groq API key — server-side only (never expose to client)
GROQ_API_KEY=

# ─── Cricket Data API ────────────────────────────────────────────────────────
# Free API key from https://cricapi.com (100 calls/day on free tier)
CRICAPI_KEY=

# ─── Firebase (client-side public config) ────────────────────────────────────
# These are safe to expose to the browser (NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
